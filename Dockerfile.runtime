# Reardon Systems — Astro Node standalone server (static pages + on-demand API).
# Builds the site and produces a runtime image that serves everything on :4321.
# Fronted by the fafo-edge nginx proxy (which forwards X-Forwarded-Proto/Host).

FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app
# PUBLIC_* values are inlined into the client bundle at build time (they are
# public by design). Non-public secrets are supplied at runtime instead.
ARG PUBLIC_SPECOPS_BETA=true
ARG PUBLIC_STRIPE_PRICING_TABLE_ID=
ARG PUBLIC_STRIPE_PUBLISHABLE_KEY=
ENV PUBLIC_SPECOPS_BETA=$PUBLIC_SPECOPS_BETA
ENV PUBLIC_STRIPE_PRICING_TABLE_ID=$PUBLIC_STRIPE_PRICING_TABLE_ID
ENV PUBLIC_STRIPE_PUBLISHABLE_KEY=$PUBLIC_STRIPE_PUBLISHABLE_KEY
COPY package.json pnpm-lock.yaml .npmrc* ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm build

FROM node:22-alpine AS runtime
RUN corepack enable
WORKDIR /app
ENV NODE_ENV=production
COPY package.json pnpm-lock.yaml .npmrc* ./
# Runtime deps only (astro and stripe are production dependencies).
RUN pnpm install --prod --frozen-lockfile
COPY --from=build /app/dist ./dist
# Persistent writable dir for on-demand writes (e.g. .data/waitlist.ndjson).
RUN mkdir -p /app/.data
ENV HOST=0.0.0.0
ENV PORT=4321
EXPOSE 4321
CMD ["node", "dist/server/entry.mjs"]
