---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Section from "../components/ui/Section.astro";
import Label from "../components/ui/Label.astro";
import Button from "../components/ui/Button.astro";

const engagements = (await getCollection("engagements")).sort(
  (a, b) => a.data.order - b.data.order,
);
const faqs = (await getCollection("faqs")).find((f) => f.data.page === "engagements");
---

<Base
  title="Engagements — Reardon Systems"
  description="Fixed-scope Assessment, Pilot, Platform Build, and Operate engagements for mid-market teams."
>
  <section class="relative overflow-hidden bg-navy text-white">
    <div class="grid-lines absolute inset-0 opacity-40"></div>
    <div class="relative mx-auto max-w-8xl px-6 py-24">
      <Label>Engagements</Label>
      <h1 class="mt-3 max-w-3xl text-4xl font-black tracking-tight md:text-6xl">
        Find the money. Then prove it.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-white/80">
        Every engagement starts with the bill and ends with a number finance and
        engineering both trust. Nothing else begins until that number exists.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/contact">Start with an Assessment</Button>
        <Button href="#engagements" variant="ghost">See the ladder</Button>
      </div>
      <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-xs text-white/60">
        <span>✓ Fixed scopes</span>
        <span>✓ Infra pass-through stays separate</span>
        <span>✓ Optional savings-share</span>
      </div>
    </div>
  </section>

  <Section id="engagements">
    <Label>The engagements</Label>
    <h2 class="mt-3 text-3xl font-black tracking-tight md:text-4xl">
      Four stages. Each one earns the next.
    </h2>
    <p class="mt-5 max-w-3xl text-lg text-slate">
      No transformation program. No multi-year roadmap signed before anyone has
      seen the bill. Each stage is a fixed scope with exit criteria, and the next
      stage only starts if the last one produced a number worth acting on.
    </p>
    <div class="mt-12">
      {
        engagements.map(({ data: e }) => (
          <article class="border-t border-rule py-16 first:border-t-0 first:pt-0">
            <div class="grid gap-8 lg:grid-cols-12">
              <div class="lg:col-span-5">
                <div class="text-xs font-bold text-electric">
                  {e.step} · {e.name}
                </div>
                <div class="mt-3 text-3xl font-black">{e.price}</div>
                <div class="mt-1 text-sm text-slate">{e.duration}</div>
                <p class="mt-5 text-slate">{e.summary}</p>
              </div>
              <div class="lg:col-span-7">
                <div class="grid gap-6 md:grid-cols-2">
                  <div>
                    <div class="text-sm font-bold tracking-wider uppercase">
                      Includes
                    </div>
                    <ul class="mt-3 space-y-2 text-sm text-slate">
                      {e.includes.map((i) => (
                        <li>{i}</li>
                      ))}
                    </ul>
                  </div>
                  <div>
                    <div class="text-sm font-bold tracking-wider uppercase">
                      What we need from you
                    </div>
                    <ul class="mt-3 space-y-2 text-sm text-slate">
                      {e.needs.map((n) => (
                        <li>{n}</li>
                      ))}
                    </ul>
                  </div>
                </div>
                <div class="mt-6 text-sm font-semibold text-navy">
                  Exit: {e.exit}
                </div>
                <div class="mt-5">
                  <Button href={e.ctaHref} variant="navy">
                    {e.cta}
                  </Button>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </Section>

  <section class="border-y border-rule bg-warm">
    <div class="mx-auto max-w-8xl px-6 py-24">
      <Label>Commercial</Label>
      <h2 class="mt-3 text-3xl font-black tracking-tight md:text-4xl">
        Fixed scope. Honest ranges. No buried fees.
      </h2>
      <p class="mt-5 max-w-3xl text-lg text-slate">
        Ranges lock to a fixed scope once we see the bill and the landing zone.
        Infrastructure pass-through stays separate from our fees, itemized, with no
        markup we don't disclose.
      </p>
      <ul class="mt-8 grid gap-4 text-slate md:grid-cols-2">
        <li>
          <strong class="text-navy">Fixed scope for craft.</strong> Our fees are for
          the work. You always know what you're buying.
        </li>
        <li>
          <strong class="text-navy">Infra pass-through separate.</strong> Hardware,
          colo, bandwidth, and cloud spend are itemized at cost.
        </li>
        <li>
          <strong class="text-navy">Optional savings-share.</strong> When it makes
          sense, we'll tie part of our fee to realized savings.
        </li>
        <li>
          <strong class="text-navy">No transformation program.</strong> No multi-year
          commitment before the first number exists.
        </li>
      </ul>
    </div>
  </section>

  {
    faqs && (
      <Section>
        <Label>FAQ</Label>
        <h2 class="mt-3 text-3xl font-black tracking-tight md:text-4xl">
          Straight answers.
        </h2>
        <div class="mt-10 divide-y divide-rule border-y border-rule">
          {faqs.data.items.map((item) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between font-semibold">
                <span>{item.q}</span>
                <span class="ml-4 text-electric transition group-open:rotate-45">
                  ＋
                </span>
              </summary>
              <p class="mt-3 max-w-3xl text-slate">{item.a}</p>
            </details>
          ))}
        </div>
      </Section>
    )
  }

  <section class="bg-navy text-white">
    <div class="mx-auto max-w-8xl px-6 py-24 text-center">
      <h2 class="text-3xl font-black tracking-tight md:text-5xl">
        Show us the bill that hurts.
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-lg text-white/75">
        Start with an Assessment. Fixed scope. Infra pass-through stays separate.
      </p>
      <div class="mt-8 flex justify-center">
        <Button href="/contact">Start with an Assessment</Button>
      </div>
    </div>
  </section>
</Base>
