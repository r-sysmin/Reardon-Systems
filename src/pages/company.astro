---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Section from "../components/ui/Section.astro";
import Label from "../components/ui/Label.astro";
import Button from "../components/ui/Button.astro";
const faqs = (await getCollection("faqs")).find((f) => f.data.page === "company");
---
<Base
  title="Company — Reardon Systems"
  description="Not anti-cloud. Anti-default. Private where it pays. Public where it bursts."
>
<!-- HERO -->
<section class="bg-navy text-white">
  <div class="mx-auto grid max-w-8xl items-center gap-12 px-6 pb-24 pt-24 lg:grid-cols-12">
    <div class="lg:col-span-8">
      <p class="text-sm font-bold uppercase tracking-widest text-electric">
        Not anti-cloud. Anti-default.
      </p>
      <h1 class="mt-3 text-4xl font-black leading-[1.05] tracking-tight md:text-6xl">
        Private where it pays.<br />Public where it bursts.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-white/80 md:text-xl">
        Reardon Systems helps mid-market teams place workloads where the
        economics hold, and still ships tools that survive a Tuesday.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/contact">Start with an Assessment</Button>
        <Button href="/products/specops" variant="ghost">See SpecOps</Button>
      </div>
    </div>
  </div>
</section>
<!-- WHAT REARDON IS -->
<Section>
  <div class="grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <Label>What Reardon Systems is</Label>
      <h2 class="mt-3 text-3xl font-black tracking-tight md:text-4xl">
        A practice, not a program.
      </h2>
    </div>
    <div class="text-lg leading-relaxed text-slate lg:col-span-7">
      <p>
        Reardon Systems is a selective cloud repatriation and private platform
        shop. We help mid-market teams move steady, data-heavy, and GPU-bound
        workloads off hyperscaler metering, and keep public cloud where burst
        and managed services earn their keep.
      </p>
      <p class="mt-4">
        We also build software. SpecOps is our own inspection product — the same
        patterns we sell, shipped in a different vertical. When the product
        itself is the job, we build it.
      </p>
    </div>
  </div>
</Section>
<!-- HOW WE WORK -->
<Section bg="warm">
  <div class="grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <Label>How we work</Label>
      <h2 class="mt-3 text-3xl font-black tracking-tight md:text-4xl">
        We practice what we pitch.
      </h2>
    </div>
    <div class="text-lg leading-relaxed text-slate lg:col-span-7">
      <p>
        Reardon Systems runs its own stack: self-hosted platforms,
        Tailscale-first access, and selective repatriation for workloads that
        should never have been metered by the hour. The tools we build for
        ourselves are the same patterns we sell — private by default, GitOps
        from day one, and software that keeps working when the environment
        doesn't cooperate.
      </p>
      <p class="mt-4 font-medium text-navy">
        We don't recommend things we haven't run. We don't sell architectures we
        wouldn't operate. And we don't send a partner to the pitch and a junior
        to the work.
      </p>
    </div>
  </div>
</Section>
<!-- TEAM -->
<Section>
  <div class="grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <Label>Who runs it</Label>
      <h2 class="mt-3 text-3xl font-black tracking-tight md:text-4xl">
        Small, senior, and hands-on.
      </h2>
    </div>
    <div class="lg:col-span-7">
      {/*
        TODO: Replace with real names, real titles, and one sentence each.
        If the team is small, the section is small. That's better than filler.
      */}
      <div class="grid gap-8 md:grid-cols-2">
        <div>
          <div class="text-sm font-bold uppercase tracking-wider text-slate">Founder & CEO</div>
          <p class="mt-2 text-slate">
            Background in infrastructure and software; built and operates the
            stack Reardon Systems sells.
          </p>
        </div>
        <div>
          <div class="text-sm font-bold uppercase tracking-wider text-slate">Platform lead</div>
          <p class="mt-2 text-slate">
            Runs the private/hybrid engagements and the Operate practice.
          </p>
        </div>
        <div>
          <div class="text-sm font-bold uppercase tracking-wider text-slate">Product lead</div>
          <p class="mt-2 text-slate">
            Owns SpecOps and custom software builds.
          </p>
        </div>
      </div>
    </div>
  </div>
</Section>
<!-- WHERE WE WORK -->
<Section bg="warm">
  <div class="grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <Label>Where we work</Label>
      <h2 class="mt-3 text-3xl font-black tracking-tight md:text-4xl">
        Remote-first, with delivery capacity where the work is.
      </h2>
      <p class="mt-5 text-slate">
        We meet clients where the work is, and keep platforms close to the metal
        that runs them.
      </p>
    </div>
    <div class="lg:col-span-7">
      {/*
        TODO: Fill in specific cities only where you actually have people or
        infrastructure.
      */}
      <ul class="space-y-4 text-slate">
        <li><span class="font-semibold text-navy">United States</span> — primary delivery base</li>
        <li><span class="font-semibold text-navy">Europe</span> — EU/UK client coverage</li>
        <li><span class="font-semibold text-navy">Asia-Pacific</span> — APAC delivery capacity</li>
      </ul>
    </div>
  </div>
</Section>
<!-- WHAT WE'RE NOT -->
<Section bg="navy">
  <div class="max-w-3xl">
    <Label>What we're not</Label>
    <h2 class="mt-3 text-3xl font-black tracking-tight md:text-4xl">
      Not a transformation program. Not a reseller. Not religious.
    </h2>
  </div>
  <ul class="mt-10 space-y-5 text-lg text-white/80">
    <li>
      <span class="font-semibold text-white">We're not anti-cloud.</span>
      Public cloud is the right answer for burst, managed services, and
      genuinely unpredictable demand.
    </li>
    <li>
      <span class="font-semibold text-white">We're not a reseller</span>
      for any hardware or cloud vendor. Placement decisions are made on unit
      economics, not on margin.
    </li>
    <li>
      <span class="font-semibold text-white">We're not selling a multi-year roadmap.</span>
      Every engagement stands on its own and earns the next one.
    </li>
  </ul>
</Section>
<!-- FAQ -->
<Section>
  <div class="max-w-3xl">
    <Label>FAQ</Label>
    <h2 class="mt-3 text-3xl font-black tracking-tight md:text-4xl">
      Questions we get asked.
    </h2>
  </div>
  {faqs && (
    <div class="mt-10 divide-y divide-rule border-y border-rule">
      {faqs.data.items.map((f) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between">
            <span class="font-semibold">{f.q}</span>
            <span class="ml-4 text-electric transition group-open:rotate-45" aria-hidden="true">＋</span>
          </summary>
          <p class="mt-3 max-w-3xl text-slate">{f.a}</p>
        </details>
      ))}
    </div>
  )}
</Section>
<!-- FINAL CTA -->
<Section bg="warm">
  <div class="grid items-center gap-12 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <h2 class="text-3xl font-black tracking-tight md:text-5xl">
        Show us the bill that hurts.
      </h2>
      <p class="mt-5 max-w-xl text-lg text-slate">
        Mid-market teams with real hyperscaler spend. Not startups guessing. Not
        enterprises buying another transformation program.
      </p>
    </div>
    <div class="lg:col-span-5">
      <Button href="/contact">Start with an Assessment</Button>
    </div>
  </div>
</Section>
</Base>
