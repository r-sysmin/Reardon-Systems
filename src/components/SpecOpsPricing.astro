---
/**
 * Stripe Pricing Table embed.
 * Create the table in Dashboard (Product catalog → Pricing tables) — not via API.
 * Uses Products/Prices/marketing_features from `pnpm stripe:sync-specops`.
 *
 * Beta (PUBLIC_SPECOPS_BETA=true, default): table stays visible; Buy/signup
 * clicks are intercepted to the waitlist (#access). Checkout only when beta is false.
 */
import Label from "./ui/Label.astro";

interface Props {
  /** When true, keep Pricing Table visible but send Buy attempts to waitlist. */
  beta?: boolean;
}

const { beta = true } = Astro.props;
const pricingTableId = import.meta.env.PUBLIC_STRIPE_PRICING_TABLE_ID ?? "";
const publishableKey = import.meta.env.PUBLIC_STRIPE_PUBLISHABLE_KEY ?? "";
const ready = Boolean(pricingTableId && publishableKey);
---
<section id="pricing" class="border-y border-rule bg-white">
  <div class="mx-auto max-w-8xl px-6 py-24">
    <div class="max-w-3xl">
      <Label>Pricing</Label>
      <h2 class="mt-3 text-3xl font-black tracking-tight md:text-4xl">
        Pro, Pro+, Business — plus Enterprise.
      </h2>
      <p class="mt-4 text-lg text-slate">
        One platform for field, back office, and online presence. No stack tax.
        No per-report fees.
      </p>
    </div>

    {beta && (
      <div class="mt-10 rounded-2xl border border-rule bg-warm p-8">
        <p class="font-semibold text-navy">Private beta</p>
        <p class="mt-2 max-w-2xl text-slate">
          Pricing is set. Self-serve checkout opens with Cohort 2.
          <a href="#access" class="font-semibold text-electric hover:text-navy">
            Join the waitlist
          </a>
          and we’ll walk you through Pro / Pro+ / Business when a spot opens.
        </p>
        <p class="mt-4 text-sm text-slate">
          Enterprise (9+ seats) is always
          <a href="/contact" class="font-semibold text-electric hover:text-navy">contact sales</a>.
        </p>
      </div>
    )}

    {ready ? (
      <div class="relative mt-10">
        <script async src="https://js.stripe.com/v3/pricing-table.js"></script>
        <stripe-pricing-table
          pricing-table-id={pricingTableId}
          publishable-key={publishableKey}
        ></stripe-pricing-table>
        {beta && (
          <a
            href="#access"
            class="absolute inset-0 z-10 flex items-end justify-center bg-transparent no-underline"
            aria-label="Private beta — join the waitlist instead of checkout"
            title="Join the waitlist"
          >
            <span class="sr-only">Join the waitlist</span>
          </a>
        )}
      </div>
    ) : (
      <div class="mt-10 rounded-2xl border border-signal/40 bg-warm p-8 text-slate">
        <p class="font-semibold text-navy">Stripe Pricing Table not configured</p>
        <p class="mt-2 text-sm">
          1. Dashboard → Product catalog → Pricing tables → create a table with
          <strong>Pro</strong>, <strong>Pro+</strong>, <strong>Business</strong>
          (month + year prices). Add <strong>Enterprise</strong> via
          “Add product with custom call-to-action” → Contact sales →
          <code class="text-navy">/contact</code> (no price).
        </p>
        <p class="mt-2 text-sm">
          2. Set <code class="text-navy">PUBLIC_STRIPE_PRICING_TABLE_ID</code> and
          <code class="text-navy">PUBLIC_STRIPE_PUBLISHABLE_KEY</code> (via
          <code class="text-navy">pnpm vault:pull</code>). Keep
          <code class="text-navy">PUBLIC_SPECOPS_BETA=true</code> until checkout
          should go live.
        </p>
      </div>
    )}
  </div>
</section>
