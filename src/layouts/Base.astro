---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import SpecOpsNav from "../components/SpecOpsNav.astro";
import Footer from "../components/Footer.astro";
interface Props {
  title: string;
  description: string;
  nav?: "site" | "specops";
  ogImage?: string;
}
const {
  title,
  description,
  nav = "site",
  ogImage = "/og.svg",
} = Astro.props;
const site = Astro.site?.toString() ?? "https://reardonsystems.com";
const canonical = new URL(Astro.url.pathname, site).toString();
const image = new URL(ogImage, site).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Reardon Systems" />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <!-- Fonts -->
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
  </head>
  <body>
    {nav === "site" ? <Nav /> : <SpecOpsNav />}
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
