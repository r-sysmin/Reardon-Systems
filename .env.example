# --- HashiCorp Vault (source of truth for secrets) ---
# Docs: docs/secrets-vault.md
# Materialize: pnpm vault:pull   Seed: pnpm vault:push
# Production Vault on ccmm (Tailscale): http://100.106.32.41:8200
VAULT_ADDR=http://100.106.32.41:8200
# VAULT_NAMESPACE=
# VAULT_KV_MOUNT=secret
# Auth: AppRole via ~/.vault-approle.json (or VAULT_ROLE_ID/VAULT_SECRET_ID);
# falls back to VAULT_TOKEN / ~/.vault-token. Never commit credentials.

# --- Stripe (prefer Vault pull over hand-editing) ---
# Active restricted key (rk_) — from Vault field secret_key
STRIPE_SECRET_KEY=
# Warmup / rotation alternate — from Vault field secret_key_next
STRIPE_SECRET_KEY_NEXT=
PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Pricing Table ID from Dashboard → Product catalog → Pricing tables
PUBLIC_STRIPE_PRICING_TABLE_ID=prctbl_...

# Webhook signing secret (Vault: apps/…/webhooks stripe_signing_secret)
STRIPE_WEBHOOK_SECRET=whsec_...

# SpecOps: keep waitlist live until you flip this (hides Pricing Table Buy CTAs)
# Not stored in Vault — preserved across vault:pull if set locally
PUBLIC_SPECOPS_BETA=true
